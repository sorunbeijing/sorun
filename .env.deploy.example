# 复制为 .env.deploy 并填入生产环境真实值（勿提交 Git）
#
# 更省事：在 Vercel Dashboard 配好变量后执行
#   pnpm deploy:pull-env
# 会自动生成 .env.deploy
#
# 或复制可提交模板（含默认 NEXTAUTH_URL）：
#   cp .env.deploy.template .env.deploy

DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

NEXTAUTH_URL="https://chinese-learning-app.vercel.app"
NEXTAUTH_SECRET="your-secret-at-least-32-chars"
AUTH_SECRET="your-secret-at-least-32-chars"

VERCEL_PROJECT_NAME="chinese-learning-app"
