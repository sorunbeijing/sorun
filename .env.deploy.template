# =============================================================================
# 部署环境变量模板（可提交 Git，不含真实密码）
# =============================================================================
#
# 用法 1 — 从 Vercel 一键同步（推荐，需先在 Dashboard 配好变量）：
#   pnpm deploy:pull-env
#
# 用法 2 — 手动复制后编辑：
#   cp .env.deploy.template .env.deploy
#   填入 Supabase 连接串后执行: .\scripts\deploy.ps1 -Migrate -Seed
#
# NEXTAUTH_URL 说明：
#   - 下方为默认 Vercel 域名（Project Name = chinese-learning-app 时）
#   - 若 Vercel 实际域名带后缀（如 chinese-learning-app-abc123.vercel.app），
#     请在首次 Deploy 后打开 Settings → Domains 复制真实地址，或运行 pnpm deploy:pull-env
# =============================================================================

DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

NEXTAUTH_URL="https://chinese-learning-app.vercel.app"
NEXTAUTH_SECRET="replace-after-vercel-pull-or-generate-with-openssl"
AUTH_SECRET="replace-after-vercel-pull-or-generate-with-openssl"

# Vercel 项目名（与 Import 时 Project Name 一致，供脚本推断域名）
VERCEL_PROJECT_NAME="chinese-learning-app"
