# =============================================================================
# 中文学习软件 — 环境变量模板
# 复制为 .env（本地）或在 Vercel → Settings → Environment Variables 中逐条添加
# 切勿将真实 .env 提交到 Git
# =============================================================================

# -----------------------------------------------------------------------------
# 数据库（必填）
# -----------------------------------------------------------------------------

# 应用运行时：Supabase Transaction Pooler（端口 6543）+ pgbouncer
# 用于 Next.js / Prisma 日常查询，适合 Serverless 高并发短连接
# 示例（请替换为你的值，密码特殊字符需 URL 编码）：
# postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.pbrjcwakwlwdonemkjug:Sakura_0201!!@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 迁移 / db push / db seed：Supabase 直连或 Session Pooler（端口 5432）
# 不要用 pgbouncer=true；Prisma migrate 需要完整 PostgreSQL 能力
# 示例：
# postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres.pbrjcwakwlwdonemkjug:Sakura_0201!!@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# Auth.js / NextAuth（必填）
# -----------------------------------------------------------------------------

# 站点完整 URL（生产必须 HTTPS，且与 Vercel 域名一致）
# 本地：http://localhost:3000
# 生产：https://your-app.vercel.app 或 https://your-custom-domain.com
NEXTAUTH_URL="http://localhost:3000"

# Session / JWT 加密密钥，至少 32 字符随机串
# 生成：openssl rand -base64 32
NEXTAUTH_SECRET="f8aK29slP0xQ7LmN3vWxR2aBcY81ZtU"

# Auth.js v5 也识别此变量（与 NEXTAUTH_SECRET 填相同值即可，二选一或都填）
AUTH_SECRET="f8aK29slP0xQ7LmN3vWxR2aBcY81ZtU"

# -----------------------------------------------------------------------------
# 应用（可选）
# -----------------------------------------------------------------------------

# development | production | test
NODE_ENV="development"

# -----------------------------------------------------------------------------
# OAuth（当前项目使用邮箱密码登录，以下均为可选，未配置可留空）
# -----------------------------------------------------------------------------

# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
